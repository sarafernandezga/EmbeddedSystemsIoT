{
  "version": "2.0.0",

  "tasks": [
    {
      "label": "West Build (auto)",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "${env:ZEPHYR_BASE}/.venv/Scripts/west.exe"
      },
      "args": [
        "build",
        "-p",
        "auto",
        "-b",
        "nucleo_wl55jc",
        "$env:PROJECT_DIR",
        "-d",
        "$env:PROJECT_DIR/build",
        "-DZephyr-sdk_DIR=${env:ZEPHYR_SDK_INSTALL_DIR}/cmake",
        "-DUSER_CACHE_DIR=${workspaceFolder}/.zephyr-cache",
        "-DDTC_OVERLAY_FILE='./boards/nucleo_wl55jc.overlay'",
        "-DCONF_FILE='./confs/prj_nucleo_wl55jc.conf'",
        "-DUSE_CCACHE=0"
      ],
      "options": {
        "cwd": "${env:ZEPHYR_BASE}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Flash (CubeProgrammer, UR+HWrst)",
      "type": "shell",
      "windows": {
        "command": "C:\\Program Files\\STMicroelectronics\\STM32Cube\\STM32CubeProgrammer\\bin\\STM32_Programmer_CLI.exe"
      },
      "args": [
        "--connect",
        "port=swd",
        "mode=UR",
        "reset=HWrst",
        "--download",
        "$env:PROJECT_DIR\\build\\zephyr\\zephyr.hex",
        "--start"
      ],
      "problemMatcher": []
    },
    {
      "label": "List COM Ports",
      "type": "shell",
      "windows": {
        "command": "powershell"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-CimInstance Win32_SerialPort | Select-Object DeviceID, Name, Description"
      ],
      "problemMatcher": []
    },
    {
      "label": "Serial Monitor",
      "type": "shell",
      "windows": {
        "command": "C:\\Program Files\\PuTTY\\plink.exe"
      },
      "args": [
        "-serial",
        "COM3",
        "-sercfg",
        "115200,8,n,1,N"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "windows": {
        "command": "powershell"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Remove-Item -Recurse -Force \"$env:PROJECT_DIR/build\" -ErrorAction SilentlyContinue"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Cache",
      "type": "shell",
      "windows": {
        "command": "powershell"
      },
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Remove-Item -Recurse -Force \"$env:PROJECT_DIR/.zephyr-cache\" -ErrorAction SilentlyContinue"
      ],
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Debug Server",
      "type": "shell",
      "windows": {
        "command": "${env:ZEPHYR_BASE}/.venv/Scripts/west.exe"
      },
      "args": [
        "debugserver",
        "-d",
        "$env:PROJECT_DIR/build"
      ],
      "options": {
        "cwd": "${env:ZEPHYR_BASE}"
      },
      "dependsOn": [
        "West Build (auto)"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "zephyr-debug",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "endsPattern": "OpenOCD GDB server running on port 3333.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Zephyr: Stop Debug Server",
      "type": "shell",
      "windows": {
        "command": "taskkill"
      },
      "args": [
        "/F",
        "/IM",
        "openocd.exe"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    }
  ]
}